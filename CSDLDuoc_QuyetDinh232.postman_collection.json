    {
      "name": "1. Xác thực (Auth)",
      "item": [
        {
          "name": "POST /auth/login (Đăng nhập cấp Access Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.access_token) {",
                  "        pm.collectionVariables.set('token', json.access_token);",
                  "        console.log('Đã lưu access_token vào biến collection: ' + json.access_token);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"nhathuoc_viet\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Mục 5.1.1 QĐ 232: Xác thực tài khoản cấp JWT Token (access_token, token_type, expires_in)."
          }
        }
      ]
    },
